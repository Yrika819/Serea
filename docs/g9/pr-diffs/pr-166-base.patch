+
+namespace {
+std::mutex engine_mutex;
+std::mutex cancellation_mutex;
+std::atomic<jlong> active_engine_id{0};
+struct RequestIdentity {
+    jlong engine_id;
+    jlong generation_id;
+    bool operator==(const RequestIdentity & other) const {
+        return engine_id == other.engine_id && generation_id == other.generation_id;
+    }
+};
+struct RequestIdentityHash {
+    size_t operator()(const RequestIdentity & request) const {
+        const auto owner_hash = std::hash<jlong>{}(request.engine_id);
+        const auto request_hash = std::hash<jlong>{}(request.generation_id);
+        return owner_hash ^ (request_hash + 0x9e3779b9 + (owner_hash << 6) + (owner_hash >> 2));
+    }
+};
+std::unordered_set<RequestIdentity, RequestIdentityHash> cancelled_requests;
+std::unordered_map<RequestIdentity, std::pair<jint, jint>, RequestIdentityHash> request_usage_counts;
+std::once_flag backend_once;
+#if defined(SEREA_NATIVE_JNI_TEST_SEAMS)
+std::atomic<bool> fail_next_load_after_model{false};
+std::atomic<jint> test_generation_progress{-1};
+std::atomic<jint> test_generation_sequence{0};
+std::atomic<jint> test_native_cancel_count{0};
+std::atomic<jlong> test_generation_engine_id{0};
+std::atomic<jlong> test_generation_id{0};
+std::atomic<jlong> test_cancel_observed_generation_id{0};
+std::atomic<jlong> test_cancelled_release_generation_id{0};
+std::atomic<jint> test_cancelled_release_sequence{0};
+std::atomic<jint> test_generation_outcome{0};
+
+constexpr jint TEST_GENERATION_ACTIVE = 1;
+constexpr jint TEST_GENERATION_COMPLETED = 2;
+constexpr jint TEST_GENERATION_CANCELLED = 3;
+constexpr jint TEST_GENERATION_FAILED = 4;
+
+class test_generation_progress_scope {
+public:
+    test_generation_progress_scope(jlong engine_id, jlong generation_id) noexcept
+            : engine_id_(engine_id), generation_id_(generation_id) {
+        test_generation_engine_id.store(engine_id_, std::memory_order_release);
+        test_generation_id.store(generation_id_, std::memory_order_release);
+        test_cancel_observed_generation_id.store(0, std::memory_order_release);
+        test_cancelled_release_generation_id.store(0, std::memory_order_release);
+        test_cancelled_release_sequence.store(0, std::memory_order_release);
+        test_generation_outcome.store(TEST_GENERATION_ACTIVE, std::memory_order_release);
+        test_generation_progress.store(0, std::memory_order_release);
+        test_generation_sequence.fetch_add(1, std::memory_order_acq_rel);
+    }
+    ~test_generation_progress_scope() noexcept {
+        // -2 means the last entered native generation has terminated. The test can distinguish
+        // an idle backend from a generation that completed between progress polls.
+        jint expected = TEST_GENERATION_ACTIVE;
+        test_generation_outcome.compare_exchange_strong(
+                expected, TEST_GENERATION_FAILED, std::memory_order_acq_rel);
+        test_generation_progress.store(-2, std::memory_order_release);
+    }
+    void observed_cancellation() noexcept {
+        if (test_generation_engine_id.load(std::memory_order_acquire) == engine_id_ &&
+                test_generation_id.load(std::memory_order_acquire) == generation_id_) {
+            test_cancel_observed_generation_id.store(generation_id_, std::memory_order_release);
+            test_generation_outcome.store(TEST_GENERATION_CANCELLED, std::memory_order_release);
+        }
+    }
+    void completed() noexcept {
+        if (test_generation_engine_id.load(std::memory_order_acquire) == engine_id_ &&
+                test_generation_id.load(std::memory_order_acquire) == generation_id_) {
+            test_generation_outcome.store(TEST_GENERATION_COMPLETED, std::memory_order_release);
+        }
+    }
+    test_generation_progress_scope(const test_generation_progress_scope &) = delete;
+    test_generation_progress_scope & operator=(const test_generation_progress_scope &) = delete;
+
+private:
+    jlong engine_id_;
+    jlong generation_id_;
+};
+#endif
+llama_model * model = nullptr;
+llama_context * context = nullptr;
+llama_sampler * sampler = nullptr;
+const llama_vocab * vocab = nullptr;
+uint32_t model_context_tokens = 0;
+
+void throw_java(JNIEnv * env, const char * class_name, const char * message);
+
+bool generation_cancelled(jlong engine_id, jlong generation_id) {
+    std::lock_guard<std::mutex> lock(cancellation_mutex);
+    return cancelled_requests.find({engine_id, generation_id}) != cancelled_requests.end();
+}
+
+bool abort_requested(void * user_data) {
+    const auto request = *static_cast<const RequestIdentity *>(user_data);
+    return generation_cancelled(request.engine_id, request.generation_id);
+}
+
+void throw_cancelled(JNIEnv * env) {
+    throw_java(env, "java/util/concurrent/CancellationException", "Inference cancelled");
+}
+
+class abort_callback_reset {
+public:
+    explicit abort_callback_reset(llama_context * context) : context_(context) {}
+    ~abort_callback_reset() noexcept {
+        try {
+            if (context_ != nullptr) llama_set_abort_callback(context_, nullptr, nullptr);
+        } catch (...) {}
+    }
+private:
+    llama_context * context_;
+};
+
+void forget_cancellation(jlong engine_id, jlong generation_id) {
+    std::lock_guard<std::mutex> lock(cancellation_mutex);
+    cancelled_requests.erase({engine_id, generation_id});
+}
+
+void forget_owner_cancellations(jlong engine_id) {
+    std::lock_guard<std::mutex> lock(cancellation_mutex);
+    for (auto request = cancelled_requests.begin(); request != cancelled_requests.end();) {
+        if (request->engine_id == engine_id) {
+            request = cancelled_requests.erase(request);
+        } else {
+            ++request;
+        }
+    }
+}
+
+void clear_engine_owner(jlong engine_id) {
+    auto expected = engine_id;
+    active_engine_id.compare_exchange_strong(expected, 0, std::memory_order_acq_rel);
+    std::lock_guard<std::mutex> lock(cancellation_mutex);
+    for (auto request = cancelled_requests.begin(); request != cancelled_requests.end();) {
+        if (request->engine_id == engine_id) {
+            request = cancelled_requests.erase(request);
+        } else {
+            ++request;
+        }
+    }
+}
+
+void clear_engine_owner_noexcept(jlong engine_id) noexcept {
+    auto expected = engine_id;
+    active_engine_id.compare_exchange_strong(expected, 0, std::memory_order_acq_rel);
+    try {
+        std::lock_guard<std::mutex> lock(cancellation_mutex);
+        for (auto request = cancelled_requests.begin(); request != cancelled_requests.end();) {
+            if (request->engine_id == engine_id) {
+                request = cancelled_requests.erase(request);
+            } else {
+                ++request;
+            }
+        }
+    } catch (...) {
+        // The atomic lease is already released; stale cancellation entries cannot own a model.
+    }
+}
+
+void throw_java(JNIEnv * env, const char * class_name, const char * message) {
+    jclass klass = env->FindClass(class_name);
+    if (klass != nullptr && !env->ExceptionCheck()) env->ThrowNew(klass, message);
+}
+
+template <typename Result, typename Body>
+Result jni_boundary(JNIEnv * env, Result fallback, Body && body) noexcept {
+    try {
+        return body();
+    } catch (const std::bad_alloc &) {
+        if (!env->ExceptionCheck()) {
+            throw_java(env, "java/lang/OutOfMemoryError", "Native runtime allocation failed");
+        }
+    } catch (const std::exception &) {
+        if (!env->ExceptionCheck()) {
+            throw_java(env, "java/lang/IllegalStateException", "Native runtime operation failed");
+        }
+    } catch (...) {
+        if (!env->ExceptionCheck()) {
+            throw_java(env, "java/lang/IllegalStateException", "Native runtime operation failed");
+        }
+    }
+    return fallback;
+}
