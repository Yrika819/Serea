+// Derived from the reviewed G3 PoC JNI implementation at a2bafeea; product wrapper is opt-in.
+#include <jni.h>
+#include <llama.h>
+
+#include <algorithm>
+#include <atomic>
+#include <cstdint>
+#include <cstdlib>
+#include <exception>
+#include <limits>
+#include <mutex>
+#include <new>
