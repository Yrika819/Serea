<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="app.serea.android.r25testime.permission.DIAGNOSTICS" />
    <application>
        <activity
            android:name="app.serea.android.googleauth.SyntheticConsentSenderActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity="app.serea.android.isolated.test"
            android:launchMode="singleTop" />
        <receiver
            android:name="app.serea.android.googleauth.SyntheticConsentSenderCompletionReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="app.serea.android.test.action.COMPLETE_SYNTHETIC_CONSENT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
