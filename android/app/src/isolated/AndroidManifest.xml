<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- This signature permission is declared by the disposable Test IME APK. Keep the
         request isolated to this instrumentation target; debug and beta variants do not use it. -->
    <uses-permission android:name="app.serea.android.r25testime.permission.DIAGNOSTICS" />
    <application>
        <activity
            android:name=".FakeGoogleProcessDeathHarnessActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:permission="android.permission.DUMP"
            android:launchMode="singleTask" />
        <activity
            android:name="app.serea.android.googleauth.PrivateGoogleInFlightDeathHarnessActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:permission="android.permission.DUMP" />
        <activity
            android:name="app.serea.android.googleauth.PrivateGoogleConsentRelayTestActivity"
            android:exported="false" />
        <activity
            android:name="app.serea.android.googleauth.PrivateGoogleConsentRelayResultHarnessActivity"
            android:exported="false" />
        <activity
            android:name="app.serea.android.googleauth.PrivateGoogleConsentSenderTestActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <receiver
            android:name=".ProcessDeathHarnessReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="app.serea.android.action.PROCESS_DEATH_HARNESS" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
