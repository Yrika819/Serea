<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- This signature permission is declared by the disposable Test IME APK. Keep the
         request isolated to this instrumentation target; debug and beta variants do not use it. -->
    <uses-permission android:name="app.serea.android.r25testime.permission.DIAGNOSTICS" />
    <application
        android:networkSecurityConfig="@xml/loopback_network_security_config">
        <!-- Exact opt-in identity attestation for persistent-AVD campaign namespaces. -->
        <meta-data
            android:name="app.serea.android.S1B_CAMPAIGN_PACKAGE"
            android:value="${sereaS1bCampaignPackage}" />
        <activity
            android:name=".FakeGoogleProcessDeathHarnessActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:permission="android.permission.DUMP"
            android:launchMode="singleTask" />
        <activity
            android:name="app.serea.android.googleauth.PrivateGoogleInFlightDeathHarnessActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:permission="android.permission.DUMP" />
        <activity
            android:name="app.serea.android.googleauth.SyntheticConsentBResultActivity"
            android:exported="false"
            android:excludeFromRecents="true" />
        <receiver
            android:name="app.serea.android.googleauth.PrivateGoogleInFlightDeathReplayReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="app.serea.android.action.REPLAY_OLD_CONSENT_RESULT" />
            </intent-filter>
        </receiver>
        <activity
            android:name="app.serea.android.googleauth.PrivateGoogleConsentRelayTestActivity"
            android:exported="false" />
        <activity
            android:name="app.serea.android.googleauth.PrivateGoogleConsentRelayResultHarnessActivity"
            android:exported="false" />
        <activity
            android:name="app.serea.android.googleauth.PrivateGoogleConsentSenderTestActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <receiver
            android:name=".ProcessDeathHarnessReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="app.serea.android.action.PROCESS_DEATH_HARNESS" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
