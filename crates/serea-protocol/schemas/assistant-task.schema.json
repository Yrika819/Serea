{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serea.local/schemas/assistant-task.schema.json",
  "title": "serea.task/1 AssistantTask",
  "description": "Serea's unit of durable work. Owning protocol: Task Protocol Section 2. This is a forward-compatible surface: undeclared fields are preserved verbatim in the host's opaque extension set and round-tripped unchanged (Protocol Index Section 4.2 rule 3). It is NOT GoalLatch's Goal; a delegated host goal is an AssistantTask of kind DELEGATED_HOST_GOAL reached through the host.goal.* capability family (Task Protocol Section 2; GoalLatch Adapter Section 5). policy_class is the host-assigned maximum risk class for the whole task and is immutable for that task; no step, approval or plan may raise it (Task Protocol Section 2.1, T6).",
  "type": "object",
  "required": [
    "task_id",
    "kind",
    "title",
    "state",
    "origin",
    "data_class",
    "policy_class",
    "created_at",
    "updated_at",
    "attempt_budget",
    "steps"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^tsk_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "maxLength": 30
    },
    "kind": {
      "type": "string",
      "enum": [
        "USER_REQUEST",
        "SCHEDULED",
        "PROACTIVE",
        "DELEGATED_HOST_GOAL",
        "MAINTENANCE"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "state": {
      "$ref": "#/$defs/taskState",
      "description": "COMPLETED, FAILED and CANCELLED are terminal. BLOCKED is not terminal: a blocked task holds its state and resumes when the condition clears."
    },
    "origin": {
      "type": "object",
      "description": "Forward-compatible, like the task that holds it: Protocol Index Section 4.1 makes a new optional field an architecture-minor change.",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "maxLength": 64,
          "description": "The frozen documents name USER_MESSAGE and freeze no closed set, so this is a validated code rather than an invented enum."
        },
        "device_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^dev_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
              "maxLength": 30
            },
            {
              "type": "null"
            }
          ]
        },
        "message_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^evt_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
              "maxLength": 30
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "data_class": {
      "$ref": "#/$defs/dataClass"
    },
    "policy_class": {
      "$ref": "#/$defs/riskClass",
      "description": "The maximum risk class across every step this task is permitted to perform. Host-assigned at creation; immutable for this task."
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp"
    },
    "deadline_at": {
      "anyOf": [
        {
          "$ref": "#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "attempt_budget": {
      "type": "object",
      "description": "Materialised on the task at creation (Bounds Protocol Section 2.1). Host-set; never model-supplied. Forward-compatible, like the task that holds it.",
      "properties": {
        "max_model_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "max_attempts_per_step": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "steps": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "blocked_reason": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ]
    },
    "result_summary": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "cancelled_at": {
      "anyOf": [
        {
          "$ref": "#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "cancelled_by": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ]
    },
    "failure_reason": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "description": "The syntactic form only. ECMA-262 regular expressions have no date arithmetic, so a calendar-impossible but well-formed value such as 2026-02-30T00:00:00Z passes this pattern; the Rust Timestamp value is the authority for calendar validity and refuses it. Every value Serea puts on the wire is deserialised into that type.",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{3})?Z$",
      "maxLength": 24
    },
    "dataClass": {
      "type": "string",
      "enum": [
        "PUBLIC",
        "PERSONAL",
        "PRIVATE",
        "SECRET",
        "CREDENTIAL"
      ]
    },
    "riskClass": {
      "type": "string",
      "enum": [
        "OBSERVE",
        "LOCAL_STATE",
        "REVERSIBLE_WRITE",
        "EXTERNAL_WRITE",
        "COMMUNICATION",
        "ELEVATED_DEVICE",
        "DESTRUCTIVE",
        "CREDENTIAL"
      ]
    },
    "taskState": {
      "type": "string",
      "enum": [
        "RECEIVED",
        "PLANNING",
        "READY",
        "EXECUTING",
        "WAITING_APPROVAL",
        "WAITING_USER",
        "VERIFYING",
        "COMPLETED",
        "FAILED",
        "BLOCKED",
        "CANCELLED"
      ]
    },
    "stepKind": {
      "type": "string",
      "enum": [
        "CAPABILITY",
        "MODEL_TURN",
        "WAIT_APPROVAL",
        "WAIT_USER",
        "WAIT_SCHEDULE",
        "VERIFY",
        "NOTIFY",
        "DELEGATE"
      ]
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "maxLength": 71
    },
    "idempotencyKey": {
      "type": "string",
      "pattern": "^idk_[0-9a-f]{64}$",
      "maxLength": 68
    },
    "capabilityId": {
      "type": "string",
      "pattern": "^(?!goallatch\\.)[a-z][a-z0-9_]{1,31}\\.[a-z][a-z0-9_]{1,31}\\.(list|read|search|open|control|write|create|send|delete|start|status|run|cancel|result)$",
      "maxLength": 99
    },
    "capabilityVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
      "maxLength": 64
    },
    "step": {
      "type": "object",
      "description": "One step of the task. Forward-compatible: Task Protocol Section 3 gives an exhaustive field list, but it does not require a closed schema, and Protocol Index Section 4.1 makes a new optional field an architecture-minor change.",
      "required": [
        "step_id",
        "task_id",
        "sequence",
        "kind",
        "status",
        "attempt",
        "idempotency_key",
        "input_digest",
        "result_digest",
        "started_at",
        "completed_at"
      ],
      "properties": {
        "step_id": {
          "type": "string",
          "pattern": "^stp_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "maxLength": 30
        },
        "task_id": {
          "type": "string",
          "pattern": "^tsk_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "maxLength": 30
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "kind": {
          "$ref": "#/$defs/stepKind"
        },
        "status": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "maxLength": 64,
          "description": "The frozen documents name SUCCEEDED and RECONCILED_ABSENT and freeze no closed set."
        },
        "attempt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "idempotency_key": {
          "$ref": "#/$defs/idempotencyKey"
        },
        "provider_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,31}$",
          "maxLength": 32
        },
        "capability_id": {
          "$ref": "#/$defs/capabilityId"
        },
        "capability_version": {
          "$ref": "#/$defs/capabilityVersion"
        },
        "input_digest": {
          "$ref": "#/$defs/digest"
        },
        "result_digest": {
          "$ref": "#/$defs/digest"
        },
        "side_effect_receipt": {
          "$ref": "#/$defs/receiptOrNull"
        },
        "started_at": {
          "$ref": "#/$defs/timestamp"
        },
        "completed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "lease_owner": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "lease_expires_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "$ref": "#/$defs/actionErrorOrNull"
        }
      }
    },
    "receiptOrNull": {
      "description": "The proof of external effect. Closed, and the same shape the serae.action/1 surface validates, so a provider cannot park an arbitrary object - including a credential-shaped one - in a step record.",
      "anyOf": [
        {
          "$ref": "#/$defs/receipt"
        },
        {
          "type": "null"
        }
      ]
    },
    "actionErrorOrNull": {
      "description": "The last failure, preserved so a terminal task explains itself. Closed for the same reason as receiptOrNull.",
      "anyOf": [
        {
          "$ref": "#/$defs/actionError"
        },
        {
          "type": "null"
        }
      ]
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "capability_id",
        "idempotency_key",
        "effect_summary",
        "observed_at",
        "replay_safe"
      ],
      "properties": {
        "receipt_id": {
          "type": "string",
          "pattern": "^rcp_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "maxLength": 30
        },
        "capability_id": {
          "$ref": "#/$defs/capabilityId"
        },
        "idempotency_key": {
          "$ref": "#/$defs/idempotencyKey"
        },
        "provider_reference": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "effect_summary": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "observed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "replay_safe": {
          "type": "boolean"
        }
      }
    },
    "actionError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "code",
        "message",
        "retryable",
        "host_action"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/actionErrorKind"
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "maxLength": 64
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "retryable": {
          "type": "boolean"
        },
        "host_action": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "maxLength": 64
        },
        "details": {
          "type": "object",
          "maxProperties": 64
        }
      }
    },
    "actionErrorKind": {
      "type": "string",
      "enum": [
        "VALIDATION",
        "UNKNOWN_CAPABILITY",
        "POLICY_DENIED",
        "APPROVAL_REQUIRED",
        "APPROVAL_DENIED",
        "CAPABILITY_UNAVAILABLE",
        "PROVIDER_ERROR",
        "PROVIDER_TIMEOUT",
        "RATE_LIMITED",
        "AUTH_EXPIRED",
        "DUPLICATE_SUPPRESSED",
        "AMBIGUOUS",
        "INTERNAL"
      ]
    }
  }
}
