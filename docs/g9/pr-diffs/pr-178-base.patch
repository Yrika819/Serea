diff --git a/tools/g8-local-model-native/check-emulator-host-libraries.sh b/tools/g8-local-model-native/check-emulator-host-libraries.sh
index 2f02eff..10fc37f 100755
--- a/tools/g8-local-model-native/check-emulator-host-libraries.sh
+++ b/tools/g8-local-model-native/check-emulator-host-libraries.sh
@@ -15,13 +15,42 @@ if [[ ! -f "$qemu_binary" || ! -x "$qemu_binary" || -L "$qemu_binary" ]]; then
     fail 'QEMU binary must be a regular executable installed by the Android SDK'
 fi
 
+qemu_directory="$(cd -- "$(dirname -- "$qemu_binary")" && pwd -P)" || \
+    fail 'QEMU SDK directory could not be resolved'
+sdk_emulator_root="$(cd -- "$qemu_directory/../.." && pwd -P)" || \
+    fail 'Android SDK emulator root could not be resolved'
+expected_qemu="$sdk_emulator_root/qemu/linux-x86_64/qemu-system-x86_64"
+[[ "$qemu_directory" == "$sdk_emulator_root/qemu/linux-x86_64" &&
+    "$qemu_directory/qemu-system-x86_64" == "$expected_qemu" ]] || \
+    fail 'QEMU binary is outside the expected Android SDK emulator layout'
+
+# Android's emulator launcher supplies these SDK-owned paths when it starts QEMU.
+# `ldd` is run directly below, so recreate that documented loader context explicitly.
+sdk_library_dirs=(
+    "$sdk_emulator_root/lib64"
+    "$sdk_emulator_root/lib64/qt/lib"
+    "$qemu_directory"
+)
+for directory in "${sdk_library_dirs[@]}"; do
+    [[ -d "$directory" ]] || fail 'required Android SDK emulator library directory is absent'
+    resolved_directory="$(cd -- "$directory" && pwd -P)" || \
+        fail 'Android SDK emulator library directory could not be resolved'
+    sdk_root_prefix="${sdk_emulator_root%/}/"
+    case "$resolved_directory/" in
+        "$sdk_root_prefix"*) ;;
+        *) fail 'Android SDK emulator library directory escaped its install root' ;;
+    esac
+done
+sdk_library_path="$(IFS=:; printf '%s' "${sdk_library_dirs[*]}")"
+
 package_state="$(dpkg-query -W -f='${Status} ${Architecture}' libpulse0:amd64 2>/dev/null)" || \
     fail 'Ubuntu libpulse0:amd64 package is not installed'
 if [[ "$package_state" != 'install ok installed amd64' ]]; then
     fail 'Ubuntu libpulse0:amd64 package is not installed'
 fi
 
-dependencies="$(ldd "$qemu_binary" 2>&1)" || fail 'ldd could not inspect the QEMU binary'
+dependencies="$(LD_LIBRARY_PATH="$sdk_library_path" ldd "$qemu_binary" 2>&1)" || \
+    fail 'ldd could not inspect the QEMU binary'
 unresolved_names=()
 malformed_unresolved=false
 while IFS= read -r dependency_line; do
diff --git a/tools/g8-local-model-native/test-emulator-host-libraries.sh b/tools/g8-local-model-native/test-emulator-host-libraries.sh
index 9e2ba8c..ddb0df8 100755
--- a/tools/g8-local-model-native/test-emulator-host-libraries.sh
+++ b/tools/g8-local-model-native/test-emulator-host-libraries.sh
@@ -6,15 +6,22 @@ CHECKER="$SCRIPT_DIR/check-emulator-host-libraries.sh"
 TEMP_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/serea-emulator-libs-test.XXXXXX")"
 trap 'rm -rf -- "$TEMP_ROOT"' EXIT
 
-mkdir -p "$TEMP_ROOT/bin" "$TEMP_ROOT/lib"
-qemu="$TEMP_ROOT/qemu-system-x86_64"
+sdk_emulator_root="$TEMP_ROOT/sdk/emulator"
+qemu_directory="$sdk_emulator_root/qemu/linux-x86_64"
+mkdir -p "$TEMP_ROOT/bin" "$TEMP_ROOT/lib" "$sdk_emulator_root/lib64/qt/lib" "$qemu_directory"
+qemu="$qemu_directory/qemu-system-x86_64"
 pulse="$TEMP_ROOT/lib/libpulse.so.0"
+export SEREA_TEST_EXPECTED_LIBRARY_PATH="$sdk_emulator_root/lib64:$sdk_emulator_root/lib64/qt/lib:$qemu_directory"
 printf '#!/usr/bin/env bash\nexit 0\n' > "$qemu"
 printf 'fixture library\n' > "$pulse"
 chmod +x "$qemu"
 
 cat > "$TEMP_ROOT/bin/ldd" <<'EOF'
 #!/usr/bin/env bash
+if [[ "${LD_LIBRARY_PATH:-}" != "$SEREA_TEST_EXPECTED_LIBRARY_PATH" ]]; then
+  printf 'libQt6CoreAndroidEmu.so.6 => not found\n'
+  exit 0
+fi
 case "${SEREA_TEST_LDD_MODE:-ok}" in
   ok)
     printf 'libpulse.so.0 => %s (0x0000000000000000)\n' "$SEREA_TEST_PULSE_PATH"
@@ -119,4 +126,35 @@ if PATH="$TEMP_ROOT/bin:$PATH" SEREA_TEST_PULSE_PATH="$pulse" \
     exit 1
 fi
 
+metachar_root="$TEMP_ROOT/sdk/*/emulator"
+metachar_qemu_dir="$metachar_root/qemu/linux-x86_64"
+outside_lib64="$TEMP_ROOT/sdk/u/emulator/lib64"
+mkdir -p "$metachar_qemu_dir" "$outside_lib64/qt/lib"
+printf '#!/usr/bin/env bash\nexit 0\n' > "$metachar_qemu_dir/qemu-system-x86_64"
+chmod +x "$metachar_qemu_dir/qemu-system-x86_64"
+ln -s "$outside_lib64" "$metachar_root/lib64"
+old_glob_would_admit() {
+    [[ "$1" == $metachar_root/* ]]
+}
+if ! old_glob_would_admit "$metachar_qemu_dir" || ! old_glob_would_admit "$outside_lib64"; then
+    echo 'emulator_host_library_contract=FAIL glob-escape fixture does not match the vulnerable prefix for both SDK and escaped directories' >&2
+    exit 1
+fi
+escape_output="$TEMP_ROOT/path-escape.out"
+metachar_expected_library_path="$metachar_root/lib64:$metachar_root/lib64/qt/lib:$metachar_qemu_dir"
+if PATH="$TEMP_ROOT/bin:$PATH" SEREA_TEST_PULSE_PATH="$pulse" \
+    SEREA_TEST_EXPECTED_LIBRARY_PATH="$metachar_expected_library_path" \
+    "$CHECKER" "$metachar_qemu_dir/qemu-system-x86_64" \
+    >"$escape_output" 2>&1; then
+    echo 'emulator_host_library_contract=FAIL accepted SDK library path escaping a metacharacter root' >&2
+    exit 1
+fi
+grep -Fxq \
+    'emulator_host_preflight=FAIL reason=Android SDK emulator library directory escaped its install root' \
+    "$escape_output"
+if grep -Fq "$outside_lib64" "$escape_output"; then
+    echo 'emulator_host_library_contract=FAIL leaked escaped directory path' >&2
+    exit 1
+fi
+
 echo 'emulator_host_library_contract=PASS resolved_shared_libraries=REQUIRED unresolved_names_sanitized=REQUIRED libpulse_package=REQUIRED symlink_alias=REJECTED'
